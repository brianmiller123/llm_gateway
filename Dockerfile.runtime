# 运行时镜像：仅打包本机编译产物（glibc 2.39 与宿主机 Ubuntu 24.04 匹配）
# 用法: cargo build --release && docker-compose up -d --build gateway
FROM ubuntu:24.04
# 时区：ubuntu:24.04 minimal 镜像不带 tzdata，需显式安装——chrono::Local
# （Coding Plan 时段窗判定、价格生效日默认值）依赖 TZ + zoneinfo，
# 默认 UTC 会让「每日 08:00-20:00 生效」类配置偏 8 小时
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*
ENV TZ=Asia/Shanghai
COPY target/release/llm_gateway /usr/local/bin/llm_gateway
COPY web/dist /app/web/dist
ENV GATEWAY_WEB_DIR=/app/web/dist
EXPOSE 443 80
ENTRYPOINT ["llm_gateway"]
